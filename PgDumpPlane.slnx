<Solution>
  <!-- ライブラリ・実機テスト・Windowsサンプルを一つのソリューションで管理します。
       Manage the library, integration tests, and Windows sample in one solution. -->
  <Folder Name="/samples/">
    <Project Path="samples/PgDumpPlane.WinForms/PgDumpPlane.WinForms.csproj" />
  </Folder>
  <Project Path="src/PgDumpPlane/PgDumpPlane.csproj" />
  <Project Path="tests/PgDumpPlane.Tests/PgDumpPlane.Tests.csproj" />
</Solution>
