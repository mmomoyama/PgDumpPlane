<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PgDumpPlane</AssemblyName>
    <RootNamespace>PgDumpPlane</RootNamespace>
    <PackageId>PgDumpPlane</PackageId>
    <Version>0.1.0</Version>
    <Authors>PgDumpPlane contributors</Authors>
    <Description>Streams a PostgreSQL database as a pg_dump-style plain-text SQL script using Npgsql.</Description>
    <PackageTags>postgresql;pg_dump;backup;npgsql;sql</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
